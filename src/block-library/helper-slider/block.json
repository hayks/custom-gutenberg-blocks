{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-slider",
	"version": "1.0.0",
	"title": "Slider",
	"category": "layout-blocks",
	"description": "Carousel of slides with items-per-view and autoplay options.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"slider_container_extra_css": {
			"type": "string",
			"default": ""
		},
		"slider_id": {
			"type": "string",
			"default": ""
		},
		"slider_items_show": {
			"type": "integer",
			"default": 1
		},
		"slider_items_show_mobile": {
			"type": "integer",
			"default": 1
		},
		"slider_items_scroll": {
			"type": "integer",
			"default": 1
		},
		"slider_items_scroll_mobile": {
			"type": "integer",
			"default": 1
		},
		"slider_infinite": {
			"type": "string",
			"default": ""
		},
		"slider_dots": {
			"type": "string",
			"default": ""
		},
		"slider_arrows": {
			"type": "string",
			"default": ""
		},
		"slider_autoplay": {
			"type": "string",
			"default": ""
		}
	},
	"providesContext": {
		"lattice/helper-slider-items-show": "slider_items_show"
	}
}

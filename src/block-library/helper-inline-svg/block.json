{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-inline-svg",
	"version": "1.0.0",
	"title": "Inline SVG",
	"category": "layout-blocks",
	"description": "Inline SVG asset rendered in the page content.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"inline_svg_upload": {
			"type": "object",
			"default": {}
		},
		"inline_svg_width": {
			"type": "string",
			"default": "100"
		},
		"inline_svg_height": {
			"type": "string",
			"default": "auto"
		},
		"inline_svg_extra_css": {
			"type": "string",
			"default": ""
		},
		"inline_svg_style": {
			"type": "string",
			"default": ""
		}
	}
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-slider-navigation",
	"version": "1.0.0",
	"title": "Slider navigation",
	"category": "layout-blocks",
	"description": "Previous/next or pagination controls for a slider.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"slider_navigation_extra_css": {
			"type": "string",
			"default": ""
		},
		"slider_navigation_type": {
			"type": "string",
			"default": "pagination"
		},
		"slider_relation_id": {
			"type": "string",
			"default": ""
		},
		"slider_icon_library": {
			"type": "string",
			"default": "carbon"
		},
		"slider_icon_size_width": {
			"type": "string",
			"default": "32"
		},
		"slider_icon_size_height": {
			"type": "string",
			"default": "32"
		},
		"slider_icon_name_prev": {
			"type": "string",
			"default": ""
		},
		"slider_icon_name_next": {
			"type": "string",
			"default": ""
		},
		"slider_icon_style": {
			"type": "string",
			"default": ""
		},
		"slider_icon_css": {
			"type": "string",
			"default": ""
		},
		"slider_icon_container_extra_css_prev": {
			"type": "string",
			"default": ""
		},
		"slider_icon_container_extra_css_next": {
			"type": "string",
			"default": ""
		}
	}
}

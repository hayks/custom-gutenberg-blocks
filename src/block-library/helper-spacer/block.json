{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-spacer",
	"version": "1.0.0",
	"title": "Spacer",
	"category": "layout-blocks",
	"description": "Vertical spacing with an adjustable height.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"spacer_type": {
			"type": "string",
			"default": "1"
		},
		"spacer_type_sm": {
			"type": "string",
			"default": ""
		},
		"spacer_type_md": {
			"type": "string",
			"default": ""
		},
		"spacer_type_lg": {
			"type": "string",
			"default": ""
		},
		"spacer_type_xl": {
			"type": "string",
			"default": ""
		},
		"spacer_type_xxl": {
			"type": "string",
			"default": ""
		},
		"spacer_extra_css": {
			"type": "string",
			"default": ""
		}
	}
}

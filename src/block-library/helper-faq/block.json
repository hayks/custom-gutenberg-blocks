{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-faq",
	"version": "1.0.0",
	"title": "Accordion",
	"category": "layout-blocks",
	"description": "FAQ accordion group, with optional structured data.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"faq_extra_css": {
			"type": "string",
			"default": ""
		},
		"faq_always_open": {
			"type": "boolean",
			"default": false
		},
		"faq_section_id": {
			"type": "string",
			"default": ""
		},
		"faq_structured_data": {
			"type": "string",
			"default": "none"
		}
	},
	"providesContext": {
		"lattice/helper-faq-always-open": "faq_always_open",
		"lattice/helper-faq-section-id": "faq_section_id",
		"lattice/helper-faq-structured_data": "faq_structured_data"
	}
}

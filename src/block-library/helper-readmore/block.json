{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-readmore",
	"version": "1.0.0",
	"title": "Read more",
	"category": "layout-blocks",
	"description": "Truncated content with a read more / read less toggle.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"readmore_id": {
			"type": "string",
			"default": ""
		},
		"readmore_container_css": {
			"type": "string",
			"default": ""
		},
		"readmore_content_css": {
			"type": "string",
			"default": ""
		},
		"readmore_button_label_more": {
			"type": "string",
			"default": ""
		},
		"readmore_button_label_less": {
			"type": "string",
			"default": ""
		},
		"readmore_button_css": {
			"type": "string",
			"default": ""
		},
		"readmore_button_label_css": {
			"type": "string",
			"default": ""
		}
	}
}

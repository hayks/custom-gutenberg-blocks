{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-icon-text",
	"version": "1.0.0",
	"title": "Text with icon",
	"category": "layout-blocks",
	"description": "Heading and text paired with an icon.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"icon_text_name": {
			"type": "string",
			"default": ""
		},
		"icon_text_library": {
			"type": "string",
			"default": "carbon"
		},
		"icon_text_size": {
			"type": "string",
			"default": "32"
		},
		"icon_text_extra_css": {
			"type": "string",
			"default": ""
		},
		"icon_text_style": {
			"type": "string",
			"default": ""
		},
		"icon_text_poistion": {
			"type": "string",
			"default": "left-top"
		},
		"icon_text_main_container_extra_css": {
			"type": "string",
			"default": ""
		},
		"icon_text_icon_container_extra_css": {
			"type": "string",
			"default": ""
		},
		"icon_text_text_container_extra_css": {
			"type": "string",
			"default": "ps-2"
		},
		"icon_text_id": {
			"type": "string",
			"default": ""
		},
		"icon_text_type": {
			"type": "string",
			"default": "regular"
		},
		"icon_text_background_upload": {
			"type": "object",
			"default": {}
		},
		"icon_text_background_width": {
			"type": "string",
			"default": "100"
		},
		"icon_text_background_height": {
			"type": "string",
			"default": "auto"
		},
		"icon_text_background_extra_css": {
			"type": "string",
			"default": ""
		},
		"icon_text_background_style": {
			"type": "string",
			"default": ""
		}
	},
	"providesContext": {
		"lattice/helper-icon-text-id": "icon_text_id"
	}
}

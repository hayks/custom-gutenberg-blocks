{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-tabs",
	"version": "1.0.0",
	"title": "Tabs",
	"category": "layout-blocks",
	"description": "Tabbed content group with switchable panels.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"tabs_navigation": {
			"type": "string",
			"default": ""
		},
		"tabs_navigation_container_css": {
			"type": "string",
			"default": "row"
		},
		"tabs_navigation_row_css": {
			"type": "string",
			"default": "row"
		},
		"tabs_navigation_col_css": {
			"type": "string",
			"default": "col-12"
		},
		"tabs_navigation_list_css": {
			"type": "string",
			"default": ""
		},
		"tabs_navigation_item_css": {
			"type": "string",
			"default": ""
		}
	}
}

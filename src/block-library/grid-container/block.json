{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/grid-container",
	"version": "1.0.0",
	"title": "Container",
	"category": "layout-blocks",
	"description": "Centered content container for rows and columns.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"container_type": {
			"type": "string",
			"default": "container"
		},
		"container_extra_css": {
			"type": "string",
			"default": ""
		}
	}
}

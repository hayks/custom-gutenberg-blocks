{
	"name": "layout-blocks",
	"private": true,
	"version": "1.1.0",
	"description": "WordPress blocks for page layout and UI — grid, cards, sliders, FAQs, tabs, and icons.",
	"author": "Hayk Sargsyan",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"copy-icons": "node scripts/copy-icons.cjs",
		"build": "npm run copy-icons && wp-scripts build --webpack-src-dir=src/block-library --blocks-manifest",
		"start": "npm run copy-icons && wp-scripts start --webpack-src-dir=src/block-library --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update"
	},
	"dependencies": {
		"@carbon/icons": "^11.88.0",
		"classnames": "^2.5.1"
	},
	"devDependencies": {
		"@wordpress/scripts": "^35.0.0",
		"ajv": "^8.20.0"
	}
}

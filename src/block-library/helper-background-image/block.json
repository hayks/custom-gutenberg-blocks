{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-background-image",
	"version": "1.0.0",
	"title": "Background Image",
	"category": "layout-blocks",
	"description": "Background image layer with overlay and watermark options.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"background_image_upload": {
			"type": "object",
			"default": {}
		},
		"background_image_position": {
			"type": "object",
			"default": {}
		},
		"background_image_extra_css": {
			"type": "string",
			"default": ""
		},
		"background_image_style": {
			"type": "string",
			"default": ""
		},
		"background_image_container_css": {
			"type": "string",
			"default": "overflow-hidden"
		},
		"watermark_image_upload": {
			"type": "object",
			"default": {}
		},
		"watermark_css": {
			"type": "string",
			"default": ""
		},
		"watermark_style": {
			"type": "string",
			"default": ""
		}
	}
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-faq-item",
	"parent": [
		"lattice/helper-faq"
	],
	"version": "1.0.0",
	"title": "Accordion item",
	"category": "layout-blocks",
	"description": "Single accordion panel with a title and expandable content.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"faq_item_extra_css": {
			"type": "string",
			"default": ""
		},
		"faq_item_text_extra_css": {
			"type": "string",
			"default": ""
		},
		"faq_item_question": {
			"type": "string",
			"default": ""
		},
		"faq_item_id": {
			"type": "string",
			"default": ""
		},
		"faq_item_always_open": {
			"type": "boolean",
			"default": false
		},
		"faq_item_section_id": {
			"type": "string",
			"default": ""
		},
		"faq_item_structured_data": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"lattice/helper-faq-always-open",
		"lattice/helper-faq-section-id",
		"lattice/helper-faq-structured_data"
	]
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/helper-navigation",
	"version": "1.0.0",
	"title": "Navigation",
	"category": "layout-blocks",
	"description": "Classic WordPress menu, with optional icons on menu items.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"attributes": {
		"navigation_menu": {
			"type": "string",
			"default": ""
		},
		"navigation_menu_columns": {
			"type": "string",
			"default": "1"
		},
		"navigation_menu_container_extra_css": {
			"type": "string",
			"default": ""
		},
		"navigation_menu_extra_css": {
			"type": "string",
			"default": ""
		},
		"navigation_menu_item_extra_css": {
			"type": "string",
			"default": ""
		},
		"navigation_menu_item_link_extra_css": {
			"type": "string",
			"default": ""
		},
		"navigation_menu_item_text_extra_css": {
			"type": "string",
			"default": ""
		}
	}
}

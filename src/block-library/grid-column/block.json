{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lattice/grid-column",
	"parent": [ "lattice/grid-row" ],
	"version": "0.1.0",
	"title": "Column",
	"category": "layout-blocks",
	"description": "Responsive column with configurable width across breakpoints.",
	"supports": {
		"html": false
	},
	"textdomain": "layout-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"column_type": {
			"type": "string",
			"default": "col-12"
		},
		"column_extra_css": {
			"type": "string",
			"default": ""
		}
	}
}
